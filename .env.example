# ==============================================================
# Nuke Target Finder Discord Bot Configuration
# ==============================================================

# Discord Bot Token (from Discord Developer Portal > Applications > Bot > Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application / Client ID (from Discord Developer Portal > General Information)
CLIENT_ID=your_discord_client_id_here

# Optional: Specific Guild ID for immediate slash command registration in development
# If left empty, slash commands will be registered globally (may take up to a few minutes)
GUILD_ID=

# Politics & War GraphQL API Key (from https://politicsandwar.com/account/ under API Key)
PNW_API_KEY=your_pnw_api_key_here

# How often the background fetcher sweeps P&W nation data (in minutes, default: 15)
FETCH_INTERVAL_MINUTES=15

# Delay between page requests during sweep (in milliseconds, default: 600)
PAGE_DELAY_MS=600

# Local SQLite Database Path (default: ./data/nukebot.db - stores coalitions only)
DATABASE_PATH=./data/nukebot.db

# Nations Split Cache Paths (optional overrides)
# NATIONS_CURRENT_PATH=./data/nations_current.json
# NATIONS_BACKUP_PATH=./data/nations_backup.json
